# Managed by Ansible (roles/auth_ui). Replaces the nginx.conf baked into the image so the
# auth upstream is set per environment instead of the hardcoded "auth:9081".

# Behind the Cloudflare Tunnel the browser used https, but nginx itself only sees http.
# Pass the real scheme on (Cloudflare sets X-Forwarded-Proto); on the LAN fall back to $scheme.
map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

# Brute-force guard for the login. Per visitor, using the client IP Cloudflare adds.
limit_req_zone $http_cf_connecting_ip zone=auth_login:10m rate=10r/m;

server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # The ONLY auth endpoints the UI uses. Everything else under /api/v1/auth/ (register, password
  # reset, other tenants' internals ...) is not reachable from outside.
  location ~ ^/api/v1/auth/session/(login|refresh|logout)$ {
    limit_req zone=auth_login burst=10 nodelay;
    rewrite ^/api/v1/auth/(.*)$ /auth/$1 break;
    proxy_pass {{ auth_ui_auth_upstream }};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
  }

  location /api/v1/auth/ {
    return 404;
  }

  # The superadmin API checks the Bearer token itself (a SUPERADMIN account is required).
  location /api/v1/superadmin/ {
    proxy_pass {{ auth_ui_auth_upstream }}/superadmin/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
