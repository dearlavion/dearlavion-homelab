# Generated by Terraform. Do not edit by hand.
[control_plane]
%{ for name, vm in vms ~}
%{ if vm.group == "control_plane" ~}
${name} ansible_host=${net_prefix}.${vm.id}
%{ endif ~}
%{ endfor ~}

[workers]
%{ for name, vm in vms ~}
%{ if vm.group == "workers" ~}
${name} ansible_host=${net_prefix}.${vm.id}
%{ endif ~}
%{ endfor ~}

[tools]
%{ for name, vm in vms ~}
%{ if vm.group == "tools" ~}
${name} ansible_host=${net_prefix}.${vm.id}
%{ endif ~}
%{ endfor ~}

[k8s:children]
control_plane
workers

[vms:children]
k8s
tools

[vms:vars]
ansible_user=ubuntu
