# Run from the repo root. Rename to Makefile:  mv Makefile.example Makefile
.PHONY: help infra host vms plan ping destroy

PLAY = cd ansible && ansible-playbook playbook/site.yml

help:
	@echo "make infra    - host setup + template + token + VMs   (target=infra)"
	@echo "make host     - host setup + template + token         (target=infra-host)"
	@echo "make vms      - VMs via Terraform, with safety check  (target=infra-vms)"
	@echo "make plan     - Terraform plan only (no changes)"
	@echo "make ping     - check all VMs answer"
	@echo "make destroy  - delete VMs 100-103 (template stays)"

infra:
	$(PLAY) -e target=infra

host:
	$(PLAY) -e target=infra-host

vms:
	$(PLAY) -e target=infra-vms

plan:
	cd terraform && terraform init && terraform plan

ping:
	cd ansible && ansible vms -m ping

destroy:
	cd terraform && terraform destroy
